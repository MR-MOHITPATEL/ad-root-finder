# Copy to .env and fill in. Never commit .env.

# --- AI (required) ---
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GOOGLE_API_KEY=

# --- Storage (required in production; leave blank for local file mode) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Scraper (needed on hosted/datacenter IPs; optional locally) ---
FACEBOOK_EMAIL=
FACEBOOK_PASSWORD=

# --- Web UI ---
APP_PASSWORD=

# --- "Run scan" button -> triggers the GitHub Actions workflow ---
GH_REPO=MR-MOHITPATEL/ad-root-finder
GH_DISPATCH_TOKEN=
